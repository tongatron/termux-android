# Copia questo file in config.env e sostituisci i placeholder.
# config.env è ignorato da Git e non deve essere pubblicato.

TERMUX_HOST=<ip-lan-o-tailscale-del-telefono>
TERMUX_USER=<utente-termux>
SSH_PORT=8022
REMOTE_WWW=~/www

# File pubblicati da scripts/deploy.sh.
SITE_INDEX=index.html
SITE_GUIDE=guida.html
SITE_CAMERA=camera.html
