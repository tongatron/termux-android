# Copy this file to config.env and replace the placeholders.
# config.env is ignored by Git and must not be published.

TERMUX_HOST=<phone-lan-or-tailscale-ip>
TERMUX_USER=<termux-user>
SSH_PORT=8022
REMOTE_WWW=~/www

# Files published by scripts/deploy.sh.
SITE_INDEX=index.html
SITE_GUIDE=guida.html
SITE_CAMERA=camera.html
